{
  "name": "safe-student-mvp",
  "version": "2.1.0",
  "private": true,
  "description": "MVP acadêmico do Safe Student com persistência relacional SQLite, migrations e dados de demonstração.",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.js",
    "test:integration": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/integration/*.test.js",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/db-migrate.js",
    "db:seed": "node --disable-warning=ExperimentalWarning scripts/db-seed.js",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/db-reset.js",
    "db:status": "node --disable-warning=ExperimentalWarning scripts/db-status.js",
    "db:import-json": "node --disable-warning=ExperimentalWarning scripts/migrate-json-to-sqlite.js",
    "reset": "npm run db:reset"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
